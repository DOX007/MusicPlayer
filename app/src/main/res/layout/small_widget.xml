<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_holder"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center">

    <ImageView
        android:id="@+id/widget_background"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignBottom="@+id/seek_controls"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:src="@drawable/widget_round_background" />

    <include
        android:id="@+id/widget_controls"
        layout="@layout/widget_controls"
        android:layout_width="match_parent"
        android:layout_height="@dimen/controls_row_height" />

    <LinearLayout
        android:id="@+id/seek_controls"
        android:layout_width="match_parent"
        android:layout_height="@dimen/controls_row_height"
        android:layout_below="@id/widget_controls"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/seek_back_btn"
            android:layout_width="@dimen/normal_icon_size"
            android:layout_height="@dimen/normal_icon_size"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_rewind_double" />

        <ImageView
            android:id="@+id/seek_forward_btn"
            android:layout_width="@dimen/normal_icon_size"
            android:layout_height="@dimen/normal_icon_size"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_forward_double" />
    </LinearLayout>

</RelativeLayout>
